# ==============================================================================
# THE NGALUNG ATELIER — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure the respective values for your deployment.
# NEVER commit real secret keys or passwords to version control.
# ==============================================================================

# Core Application & Runtime Settings
NODE_ENV=production
PORT=3000
# The public HTTPS base domain where this application is hosted (e.g. https://ngalungatelier.com)
APP_URL=
# Alternative public URL declaration (if different from APP_URL)
PUBLIC_APP_URL=
# Optional custom API base path if reverse-proxied (defaults to root /)
API_BASE_URL=

# Gemini AI Platform API (Server-side only secret)
GEMINI_API_KEY=

# Administrator Authentication (Secure Server-Side Isolated Auth)
# Generate a high-entropy password (min 16 chars) and a 64-char crypto session secret
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=

# Razorpay Payment Gateway (TEST MODE for pre-launch, switch to LIVE for real payments)
# TEST Mode Key ID starts with 'rzp_test_'
# LIVE Mode Key ID starts with 'rzp_live_'
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook Secret configured in your Razorpay Dashboard -> Webhooks -> Secret
RAZORPAY_WEBHOOK_SECRET=
# Store Authoritative Currency (INR or USD)
RAZORPAY_CURRENCY=INR

# Transactional Email Service (Options: resend | smtp | postmark | sendgrid | console | none)
# Default is 'console' for safe local development / logging
EMAIL_PROVIDER=console
EMAIL_FROM=orders@ngalungatelier.com
EMAIL_FROM_NAME="The Ngalung Atelier"
SUPPORT_EMAIL=support@ngalungatelier.com

# Email Provider API Credentials (Configure the one corresponding to EMAIL_PROVIDER)
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=

# SMTP Server Credentials (If EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ==============================================================================
# DURABLE PRODUCTION PERSISTENCE (PostgreSQL Database)
# ==============================================================================
# Full PostgreSQL connection URI (e.g. postgres://user:password@host:5432/dbname?sslmode=require)
DATABASE_URL=
DATABASE_SSL=true

# ==============================================================================
# PRIVATE DIGITAL PRODUCT OBJECT STORAGE (Supabase Storage / Amazon S3)
# ==============================================================================
# Provider selection: supabase | s3 | local (local is only for development)
STORAGE_PROVIDER=local
MAX_PRODUCT_FILE_MB=100

# Supabase Storage Configuration (if STORAGE_PROVIDER=supabase)
# Requires a PRIVATE bucket created in Supabase Dashboard -> Storage -> New Bucket (Public: OFF)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=private_products

# Amazon S3 / S3-Compatible Storage Configuration (if STORAGE_PROVIDER=s3)
# Compatible with AWS S3, Cloudflare R2, MinIO, Wasabi, DigitalOcean Spaces
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional S3 custom endpoint (Required for Cloudflare R2, MinIO, Wasabi)
S3_ENDPOINT=
# Set to true for MinIO or path-style S3 compatible services
S3_FORCE_PATH_STYLE=false
