{
  "name": "the-ngalung-atelier",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "node ./node_modules/vite/bin/vite.js build && node scripts/build-server.mjs",
    "start": "node dist/server.cjs",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "migrate:schema": "node --import tsx server/db/migrate.ts",
    "migrate:data": "node --import tsx server/db/importJsonData.ts",
    "migrate:data:dry-run": "node --import tsx server/db/importJsonData.ts --dry-run",
    "migrate:storage": "node --import tsx server/storage/migrateStorage.ts",
    "migrate:storage:dry-run": "node --import tsx server/storage/migrateStorage.ts --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
